<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEj11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="Ejercicio 11: Nota y Contador"
        app:titleTextColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textoContadorEj11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ediciones realizadas: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textoNotaEj11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota inicial: Comprar víveres para la semana."
            android:textSize="20sp"
            android:gravity="center"
            android:padding="16dp" />
    </LinearLayout>
</LinearLayout>