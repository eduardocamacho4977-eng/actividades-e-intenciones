<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paso 2: Multiplicar Número"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textoValorSumaEj6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor tras sumar: 15"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/campoMultiplicarEj6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Factor a multiplicar"
        android:text="2"
        android:inputType="numberSigned"
        android:padding="12dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/botonFinalizarEj6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Multiplicar y Devolver a MainActivity" />
</LinearLayout>